# ews-mcp 4.5 — example configuration.
# Copy to `.env` in the directory you run `ewsmcp` from (auto-loaded),
# or put these in your MCP client's `env` block instead.
# NEVER commit a real .env.

# --- Exchange (required) -------------------------------------------------
EWS_SERVER_URL=https://ews.example.com/EWS/Exchange.asmx
EWS_EMAIL=user@example.com
EWS_USERNAME=user
EWS_PASSWORD=change-me
# Keep unset so exchangelib auto-negotiates (empty values are treated as unset);
# accepted values when pinning a scheme: basic, ntlm, digest.
#EWS_AUTH_TYPE_FORCE=
# Lockout guard on HTTP 401 rejections (cooldown in seconds + per-process cap):
#EWS_AUTH_FAILURE_COOLDOWN_SECONDS=900
#EWS_AUTH_MAX_REJECTIONS=3

# --- Safety (defaults shown; already safe) --------------------------------
# read = read-only tools; draft = + drafts/labels; full = + send/delete
EWS_CAPABILITY_TIER=draft
# Global send kill-switch. Nothing sends while this is false. With it true:
# send_draft, meeting responses, automatic replies and cancellations also need
# tier=full; invitations and update notices (create_event / update_event) need
# only tier=draft and a confirmation.
SEND_ENABLED=false
#EWS_RECIPIENT_ALLOWLIST=*@example.com
#EWS_MAX_SENDS_PER_HOUR=10
# Optional directory for path-based draft attachments (empty = disabled):
#EWS_ATTACHMENT_DIR=./attachments
# Per-call attachment size ceiling in MiB (1..50; HTTP body limit derives from this):
#EWS_MAX_ATTACHMENT_MB=25
# On Linux, keep process dumpability on for ptrace/core-dump debugging
# (default false marks the server non-dumpable before starting attachment workers):
#EWS_KEEP_DUMPABLE=false
# Set this to keep confirm tokens valid across restarts:
#SEND_CONFIRM_SECRET=generate-a-long-random-string

# --- Storage: local disk ONLY (cloud-synced folders are refused) ----------
# Default is ~/.ewsmcp. If your home directory is synced (OneDrive etc.),
# point this at a plain local path:
#DATA_DIR=C:\ewsmcp-data

# --- HTTP mode only (all unused over stdio) --------------------------------
#MCP_TRANSPORT=http
#MCP_HOST=127.0.0.1
#MCP_PORT=8000
#MCP_API_KEY=generate-a-long-random-string

# --- Many users from one deployment (bearer mode) ---------------------------
# Every HTTP request carries the user's own EWS OAuth2 access token
# (Authorization: Bearer ...); EWS_EMAIL / EWS_USERNAME / EWS_PASSWORD are then
# unused. Requires MCP_TRANSPORT=http. See docs/SCALING.md.
#EWS_AUTH_MODE=bearer
# Token claims holding the mailbox address (first match wins):
#EWS_TOKEN_MAILBOX_CLAIMS=email,upn,preferred_username,unique_name
# Optional stable user id that keys each user's stored state:
#EWS_TOKEN_IDENTITY_CLAIM=sid
# Tokens are verified locally (signature, issuer, audience, expiry):
#EWS_TOKEN_JWKS_URL=https://adfs.example.com/adfs/discovery/keys
#EWS_TOKEN_ISSUER=http://adfs.example.com/adfs/services/trust
#EWS_TOKEN_AUDIENCE=https://mail.example.com/
#EWS_TOKEN_ALGORITHMS=RS256
# Shared state across pods (spent confirm tokens, send caps, budgets, aliases):
#EWS_STATE_BACKEND=redis
#EWS_REDIS_URL=redis://valkey:6379/0
# Exchange protection (bearer defaults shown):
#EWS_MAX_CONCURRENCY=32
#EWS_QUEUE_TIMEOUT_SECONDS=10
#EWS_MAILBOX_MAX_CONCURRENCY=2
#EWS_MAILBOX_CALLS_PER_MINUTE=60
#EWS_GLOBAL_CIRCUIT_THRESHOLD=20
#EWS_GLOBAL_MAX_SENDS_PER_HOUR=0
# Optional per-user window mirror (off by default in bearer mode):
#EWS_CACHE_ENABLED=true
#EWS_CACHE_WINDOW_DAYS=14
#EWS_CACHE_BODY_CHARS=300
#EWS_MAILBOX_IDLE_SECONDS=1800

# --- Misc ------------------------------------------------------------------
# IANA timezone name for date inputs, recurring series, and display (default UTC):
#EWS_TZ=UTC
#LOG_LEVEL=INFO
